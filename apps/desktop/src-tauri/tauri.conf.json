{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hear",
  "version": "0.1.63",
  "identifier": "com.hear.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "听见 Hear — 桌面实时翻译工作台",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 580,
        "resizable": true,
        "decorations": false,
        "center": true
      },
      {
        "label": "subtitle",
        "title": "听见 — 悬浮字幕",
        "url": "subtitle.html",
        "width": 760,
        "height": 148,
        "minWidth": 360,
        "minHeight": 80,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* https://127.0.0.1:* https://*; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "uninstallerHeaderImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
